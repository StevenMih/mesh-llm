From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sat, 12 Sep 2026 01:12:30 -0700
Subject: [PATCH] fix(skippy): stop multiplying ctx_size by lane_count for the
 shared KV pool

ctx_size is the total kv_unified pool size (planned as such by the Rust
host-runtime's context_planning.rs, which sizes it to fit the KV budget
at context_slot_target()==1), not a per-lane allocation. Patch 18
(fix-skippy-reserve-context-capacity-per-lane) multiplied it by
lane_count, producing an n_ctx 4x larger than the KV budget allows
(e.g. 131072 x 4 = 524288 cells / 30GB for a 3B model), which blows the
Metal compute-buffer budget on the very first decode
(kIOGPUCommandBufferCallbackErrorOutOfMemory) and surfaces as
llama_decode failed rc=-3.

Fixes the shared skippy_context_capacity() helper used by both
skippy_finish_model_open and skippy_model_attach_mtp_draft_model so
n_ctx equals ctx_size directly; every lane already shares that one
pool under kv_unified. Updates the native accounting test that
asserted the old (wrong) 3x multiplication.
---
 src/skippy/model_loading.cpp                  | 27 +++++++++++++------
 tests/test-skippy-model-loader-accounting.cpp |  7 +++--
 2 files changed, 24 insertions(+), 10 deletions(-)

diff --git a/src/skippy/model_loading.cpp b/src/skippy/model_loading.cpp
index 13dc3d8ee..a07fdf981 100644
--- a/src/skippy/model_loading.cpp
+++ b/src/skippy/model_loading.cpp
@@ -495,14 +495,24 @@ static bool skippy_context_capacity(
                          uint32_t   lane_count,
                          uint32_t & context_size_per_lane,
                          uint32_t & context_size_total) {
-    context_size_per_lane = config != nullptr && config->ctx_size > 0
+    // `ctx_size` is already the total shared KV-cell pool, not a per-lane
+    // allocation: skippy runs kv_unified whenever lane_count > 1, and every
+    // admitted lane's sequence shares that one llama_context_params.n_ctx
+    // pool (see llama-context.cpp's memory->init_batch/find_slot path). The
+    // Rust-side planner (context_planning.rs::plan_runtime_resources) already
+    // sizes `ctx_size` to fit that single shared pool inside the node's KV
+    // budget at `context_slot_target() == 1`. Multiplying by lane_count here
+    // re-introduces the kv_unified=false accounting the planner's own
+    // comments reject, over-allocates the KV cache by lane_count x, and
+    // blows the Metal/CUDA compute-buffer budget on the very first decode
+    // (observed: kIOGPUCommandBufferCallbackErrorOutOfMemory on a 3B model
+    // asking for a 524288-cell / 30GB pool sized for 4 lanes of a 131072-cell
+    // context that alone already fit the budget).
+    (void)lane_count;
+    context_size_total = config != nullptr && config->ctx_size > 0
         ? static_cast<uint32_t>(config->ctx_size)
         : 512;
-    lane_count = std::max<uint32_t>(lane_count, 1);
-    if (context_size_per_lane > std::numeric_limits<uint32_t>::max() / lane_count) {
-        return false;
-    }
-    context_size_total = context_size_per_lane * lane_count;
+    context_size_per_lane = context_size_total;
     return true;
 }
 
@@ -588,8 +598,9 @@ enum skippy_status skippy_finish_model_open(
     stage_model->lane_count = lane_count;
 
     llama_context_params params = llama_context_default_params();
-    // ctx_size is the per-lane request limit. llama.cpp's n_ctx is the total
-    // cell pool, so every simultaneously admitted lane needs that capacity.
+    // ctx_size is already the total shared cell pool (see
+    // skippy_context_capacity above); every simultaneously admitted lane
+    // shares that one pool under kv_unified rather than getting its own.
     params.n_ctx = context_size_total;
     params.n_batch = config != nullptr && config->n_batch > 0 ? static_cast<uint32_t>(config->n_batch) : context_size_per_lane;
     params.n_ubatch = config != nullptr && config->n_ubatch > 0 ? static_cast<uint32_t>(config->n_ubatch) : 0u;
diff --git a/tests/test-skippy-model-loader-accounting.cpp b/tests/test-skippy-model-loader-accounting.cpp
index 1e6c8602c..d68d3faea 100644
--- a/tests/test-skippy-model-loader-accounting.cpp
+++ b/tests/test-skippy-model-loader-accounting.cpp
@@ -263,13 +263,16 @@ static bool check_multilane_context_capacity(const char * model_path) {
         return false;
     }
 
+    // ctx_size is the total shared kv_unified pool, not a per-lane
+    // allocation: 3 lanes share the same 256-cell pool, they do not each get
+    // their own 256 cells (see skippy_context_capacity in model_loading.cpp).
     const llama_context * context = skippy_session_llama_context(session);
-    const bool valid = context != nullptr && llama_n_ctx(context) == 3 * 256;
+    const bool valid = context != nullptr && llama_n_ctx(context) == 256;
     if (!valid) {
         std::fprintf(
                 stderr,
                 "multi-lane context capacity mismatch: expected %d cells, got %u\n",
-                3 * 256,
+                256,
                 context != nullptr ? llama_n_ctx(context) : 0);
     }
 
-- 
